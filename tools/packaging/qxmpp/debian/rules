#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

CMAKEOPTS = -DBUILD_TESTING=OFF \
            -DBUILD_DOCUMENTATION=OFF \
            -DBUILD_EXAMPLES=OFF \
            -DBUILD_OMEMO=ON \
            -DWITH_ENCRYPTION=ON \
            -DWITH_GSTREAMER=ON

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- $(CMAKEOPTS)

override_dh_auto_test:
