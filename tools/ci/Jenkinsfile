// Build logic for every LeechCraft CI job.
//
// Job-level configuration (triggers, parameters, retention) lives in jobs.groovy so that several jobs can
// share this file; the PROFILE parameter picks the cells to build:
//   quick   the primary distro with the primary compiler; a warning its reference build did not have makes it
//           unstable; unless it failed, triggers the DOWNSTREAM job, or the IMAGES job when the push touched the
//           images, which rebuilds them and triggers DOWNSTREAM itself
//   full    every distro under tools/docker/base with every compiler in COMPILERS that the distro's image
//           ships in at least the MINIMUM version, using a libstdc++ at least as new as the gcc floor, one
//           cell at a time
// A cell builds the checkout with tools/docker/runci.sh inside the distro's image, scans the compiler output
// with Warnings NG and publishes the result, and archives ninja's log of the build, ninja-logs/<cell>.ninja_log, the start
// and end of every step, which tools/ci/ninjalog.py reads. The full profile also publishes, per compiler, one result over all its cells
// with the repeats dropped, and a badge per cell for the README, under the cell's name, which says passing, failing, or why
// the cell was skipped.
// Every build, in every job, takes the same lock around its compile, so only one build runs at a time and
// build times stay comparable. The full profile compiles through ccache, one cache for all cells on a partition
// of the agent dedicated to it, since its build times are not the measurement; the quick profile does not, so
// that its build time stays comparable from build to build. A cell that fails to configure or to build fails the run; the message
// names which, since on a rolling distro a configure failure almost always means a dependency moved.

import groovy.transform.Field

@Field final String AGENT = 'real'
@Field final String BUILD_LOCK = 'lc-build'
@Field final String CCACHE_HOST_DIR = '/var/cache/ci-ccache'
@Field final String NINJA_LOGS = 'ninja-logs'
@Field final List<String> COMPILERS = ['gcc', 'clang']
@Field final Map<String, Integer> MINIMUM = [gcc: 16, clang: 23]
@Field final Map PRIMARY = [distro: 'opensuse_factory', compiler: 'clang']
@Field final Map NEW_WARNINGS_GATE = [threshold: 1, type: 'NEW', criticality: 'UNSTABLE']

String cellName(Map cell) {
    cell.tidy ? "tidy-${cell.distro}" : "${cell.distro}-${cell.compiler}"
}

// Major version of the cell's compiler inside the distro's image (`version`), or the release of the libstdc++ it
// uses (`stdlib`); 0 when the image has none. A failure of the probe itself fails the build: no image or no docker
// is a broken setup, not a missing compiler.
int probe(Map cell, String what) {
    String out = sh(returnStdout: true, label: "probe ${cellName(cell)} ${what}",
                    script: "tools/docker/runci.sh ${cell.distro} ${cell.compiler} ${what}").trim()
    out.isInteger() ? Integer.parseInt(out) : 0
}

Map planCells(List<String> excluded) {
    List<Map> cells = []
    Map<String, String> skipped = [:]
    for (String distro in sh(returnStdout: true, script: 'ls tools/docker/base').trim().tokenize('\n')) {
        for (String compiler in COMPILERS) {
            Map cell = [distro: distro, compiler: compiler]
            String name = cellName(cell)
            if (excluded.contains(name)) {
                skipped[name] = 'excluded by SKIP_CELLS'
                continue
            }
            int have = probe(cell, 'version')
            if (have == 0) {
                skipped[name] = "no ${compiler} in the image"
                continue
            }
            if (have < MINIMUM[compiler]) {
                skipped[name] = "${compiler} ${have} is older than ${MINIMUM[compiler]}"
                continue
            }
            // clang uses the system's libstdc++, whose C++26 coverage is what the gcc floor really states
            int lib = compiler == 'gcc' ? have : probe(cell, 'stdlib')
            if (lib == 0)
                skipped[name] = "no libstdc++ behind ${compiler}"
            else if (lib < MINIMUM.gcc)
                skipped[name] = "libstdc++ ${lib} is older than ${MINIMUM.gcc}"
            else
                cells << cell
        }
    }
    [cells: cells, skipped: skipped]
}

// One badge per cell, selected by `config=<cell name>` on the job's badge URL. A skipped cell gets its reason as the
// status, so that it reads as skipped rather than as failing or as missing. The colour is set with every status, here
// and when a cell finishes: a colour set once sticks, and a badge without one takes the colour of the whole build,
// which is red as soon as any cell fails.
Map registerBadges(Map plan) {
    Map badges = [:]
    for (Map cell in plan.cells) {
        String name = cellName(cell)
        badges[name] = addEmbeddableBadgeConfiguration(id: name, subject: name, status: 'pending', color: 'lightgrey')
    }
    plan.skipped.each { String name, String why ->
        addEmbeddableBadgeConfiguration(id: name, subject: name, status: why, color: 'lightgrey')
    }
    badges
}

// Warnings NG only computes new and fixed issues against a reference build chosen by the Forensics step above:
// without it every issue counts as outstanding. The first sed folds the path through which moc-generated
// sources include a header (build dir, autogen dir, then ../.. back into the checkout) onto the header itself,
// so such a warning is one issue with a source file rather than two, one of them unresolvable. The quick profile keeps the id `gcc` and the gcc parser of the
// matrix job it replaced, so that the trend and that comparison continue across the migration. Source paths are rewritten to the workspace's
// absolute path for the same reason, and because Warnings NG otherwise anchors relative paths to the build
// directory it spots in CMake's output, which does not exist outside the container.
// opts: `historical` keeps the id and parser of the matrix job the quick job replaced, `cached` compiles through ccache,
// `gated` applies NEW_WARNINGS_GATE.
Map runCell(Map opts, Map cell) {
    String name = cellName(cell)
    String log = "${name}.log"
    int rc = 0
    List<String> environment = ["NINJA_LOG=${env.WORKSPACE}/${NINJA_LOGS}/${name}.ninja_log"]
    if (opts.cached)
        environment << "CCACHE_HOST_DIR=${CCACHE_HOST_DIR}"
    lock(BUILD_LOCK) {
        withEnv(environment) {
            rc = sh(returnStatus: true, label: "build ${name}", script: """#!/bin/bash
set -o pipefail
tools/docker/runci.sh ${cell.distro} ${cell.compiler} ${cell.tidy ? 'tidy' : 'build'} 2>&1 \\
    | sed -e 's|/work/build/[^ :]*/\\.\\./leechcraft/|/work/leechcraft/|g' \\
          -e 's|/work/leechcraft/|${env.WORKSPACE}/|g' | tee ${log}
""")
        }
    }
    archiveArtifacts(artifacts: "${NINJA_LOGS}/${name}.ninja_log", allowEmptyArchive: true)
    def tool
    if (cell.tidy)
        tool = clangTidy(pattern: log, id: name, name: name)
    else if (opts.historical)
        tool = gcc(pattern: log)
    else if (cell.compiler == 'clang')
        tool = clang(pattern: log, id: name, name: name)
    else
        tool = gcc(pattern: log, id: name, name: name)
    def report = scanForIssues(tool: tool, sourceCodeRetention: 'EVERY_BUILD')
    // Warnings NG labels a result after its parser unless the publish step names it, so every cell would read
    // "GNU C Compiler (GCC)" in the sidebar and "Static Analysis" in the job's aggregated trend.
    Map publish = [issues: [report], name: name]
    // The gate compares with the reference build discoverReferenceBuild picked, the last build that was at least unstable,
    // not with the last build that passed the gate (ignoreQualityGate). A warning flagged once is thus part of the baseline
    // the next time: a push that adds warnings gets one unstable build and one mail, and a deliberate wave, such as
    // deprecating a function and so flagging every caller, does not keep the job unstable until the last caller is gone.
    if (opts.gated)
        publish += [qualityGates: [NEW_WARNINGS_GATE], ignoreQualityGate: true]
    publishIssues(publish)
    [name: name, rc: rc, report: report]
}

void grade(Map outcome) {
    if (outcome.rc == 0)
        return
    String what = outcome.rc == 2 ? 'configure failed, most likely a missing dependency'
                : outcome.rc == 1 ? 'build failed'
                : "runner failed with status ${outcome.rc}, probably a tool missing from the image"
    error("${outcome.name}: ${what}")
}

// The paths the build's changes touched: empty for a first build and for one started by hand.
List<String> changedPaths() {
    List<String> paths = []
    for (def changes in currentBuild.changeSets)
        for (def entry in changes.items)
            paths.addAll(entry.affectedPaths)
    paths
}

// The distros whose images the changes made stale: null when they did not touch the images, empty for all of them
// (the packaging or the image build itself changed), else the distros whose Dockerfile directory changed.
List<String> staleDistros(List<String> paths) {
    if (paths.any { it in ['tools/packaging.ref', 'tools/docker/buildimage.sh'] })
        return []
    List<String> distros = paths.findAll { it.startsWith('tools/docker/base/') }.collect { it.tokenize('/')[3] }.unique()
    distros ?: null
}

// The quick job mails on every failure and every unstable build, since each one is a push that broke the build or added
// a warning; the full job mails only when its status changes, since a distro that stays broken for a week is one piece of
// news, not seven.
void notifyIfNeeded(boolean everyProblem) {
    String now = currentBuild.currentResult
    String previous = currentBuild.previousCompletedBuild?.result ?: 'SUCCESS'
    boolean newsworthy = now != previous || (everyProblem && now in ['FAILURE', 'UNSTABLE'])
    if (!params.NOTIFY || now == 'ABORTED' || !newsworthy)
        return
    emailext(to: params.NOTIFY, recipientProviders: [culprits(), requestor()],
             subject: '$PROJECT_NAME - Build #$BUILD_NUMBER - $BUILD_STATUS',
             body: '$PROJECT_NAME - Build #$BUILD_NUMBER - $BUILD_STATUS\n\n$BUILD_URL\n\nChanges:\n$CHANGES')
}

String profile = params.PROFILE ?: 'quick'
List<String> excluded = (params.SKIP_CELLS ?: '').tokenize(', ')

timeout(time: 6, unit: 'HOURS') {
    try {
        if (profile == 'quick') {
            stage(cellName(PRIMARY)) {
                node(AGENT) {
                    checkout scm
                    discoverReferenceBuild(requiredResult: 'UNSTABLE')
                    grade(runCell(PRIMARY, historical: true, gated: true))
                }
            }
            if (currentBuild.currentResult in ['SUCCESS', 'UNSTABLE']) {
                // A push that touches the images gets them rebuilt first; the image job then triggers DOWNSTREAM itself,
                // against the new images, where this build could only have run it against the stale ones.
                List<String> stale = params.IMAGES ? staleDistros(changedPaths()) : null
                if (stale != null) {
                    stage("Trigger ${params.IMAGES}") {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            build job: params.IMAGES, wait: false,
                                  parameters: [string(name: 'DISTROS', value: stale.join(',')),
                                               booleanParam(name: 'ALWAYS_TRIGGER', value: true)]
                        }
                    }
                } else if (params.DOWNSTREAM) {
                    stage("Trigger ${params.DOWNSTREAM}") {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            build job: params.DOWNSTREAM, wait: false
                        }
                    }
                }
            }
        } else {
            node(AGENT) {
                checkout scm
                discoverReferenceBuild(requiredResult: 'UNSTABLE')
                Map plan
                Map badges
                stage('Plan') {
                    plan = planCells(excluded)
                    String summary = "cells: ${plan.cells.collect { cellName(it) }.join(', ')}"
                    if (plan.skipped)
                        summary += '; skipped: ' + plan.skipped.collect { name, why -> "${name}: ${why}" }.join('; ')
                    echo summary
                    currentBuild.description = summary
                    badges = registerBadges(plan)
                }
                Map reports = [:]
                plan.cells.each { Map cell ->
                    String name = cellName(cell)
                    stage(name) {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            Map outcome = runCell(cell, cached: true)
                            reports[name] = outcome.report
                            badges[name].setStatus(outcome.rc == 0 ? 'passing' : 'failing')
                            badges[name].setColor(outcome.rc == 0 ? 'brightgreen' : 'red')
                            grade(outcome)
                        }
                    }
                }
                // The per-cell results cannot be merged without counting every repeat: an issue's identity includes the
                // tool that reported it, so one line flagged by ten cells is ten issues. Parsing the cells' logs again as one
                // log per compiler makes the repeats identical, and the parser drops them. gcc and clang stay apart, since
                // they put the same warning at different columns and word it differently.
                if (reports) {
                    stage('Aggregate') {
                        for (String compiler in COMPILERS) {
                            List<String> logs = reports.keySet().findAll { it.endsWith("-${compiler}") }.collect { "${it}.log" }
                            if (!logs)
                                continue
                            String log = "aggregate.${compiler}.log"
                            sh(label: "concatenate ${compiler} logs", script: "cat ${logs.join(' ')} > ${log}")
                            String id = "all-${compiler}"
                            def tool = compiler == 'clang' ? clang(pattern: log, id: id, name: id) : gcc(pattern: log, id: id, name: id)
                            publishIssues(issues: [scanForIssues(tool: tool)], name: id)
                        }
                    }
                }
            }
        }
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
        currentBuild.result = 'ABORTED'
        throw e
    } catch (e) {
        currentBuild.result = 'FAILURE'
        throw e
    } finally {
        notifyIfNeeded(profile == 'quick')
    }
}
